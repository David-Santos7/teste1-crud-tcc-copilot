{
  "name": "appointment-system",
  "version": "1.0.0",
  "description": "Sistema de agendamento full stack usando Express, SQLite e EJS",
  "main": "src/main/server.js",
  "scripts": {
    "dev": "nodemon src/main/server.js",
    "start": "node src/main/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test"
