  "keywords": [
    "appointment",
    "express",
    "sqlite",
    "ejs"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "eslint": "^10.12.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
