<%- include('../partials/header') %>
<h1>Editar agendamento</h1>

<% if (errorMessage) { %>
  <div class="error-box"><%= errorMessage %></div>
<% } %>

<form action="/appointments/<%= appointment.id %>/update" method="POST">
  <div class="form-grid">
    <div class="field">
      <label for="clientName">Nome do cliente</label>
      <input id="clientName" name="clientName" type="text" value="<%= appointment.clientName %>" required />
    </div>

    <div class="field">
      <label for="service">Serviço</label>
      <input id="service" name="service" type="text" value="<%= appointment.service %>" required />
    </div>

    <div class="field">
      <label for="appointmentDate">Data</label>
      <input id="appointmentDate" name="appointmentDate" type="date" value="<%= appointment.appointmentDate %>" required />
    </div>

    <div class="field">
      <label for="appointmentTime">Horário</label>
      <input id="appointmentTime" name="appointmentTime" type="time" value="<%= appointment.appointmentTime %>" required />
    </div>

    <div class="field full">
      <label for="notes">Observações</label>
      <textarea id="notes" name="notes"><%= appointment.notes || "" %></textarea>
    </div>
  </div>

  <div class="actions">
    <button type="submit">Salvar alterações</button>
    <a class="button secondary" href="/appointments/<%= appointment.id %>">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
